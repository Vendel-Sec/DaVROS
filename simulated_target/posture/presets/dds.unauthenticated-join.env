# A.3.2 and A.3.3. PKI-DH stays perfectly configured, and governance admits
# unauthenticated participants anyway. Every topic is still protected, so they
# match nothing: this isolates the leaves in the governance document. For the
# network view, use dds.unauthenticated-join-open-topics.
TARGET_ALLOW_UNAUTHENTICATED=true
TARGET_JOIN_AC=false
