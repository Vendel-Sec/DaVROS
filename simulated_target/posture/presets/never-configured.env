# The A.0 family together: a deployment where SROS2 was never used. The team
# relied on the network perimeter, so nobody ran the ros2 security verbs and
# nobody set the variables. This is Act 1 of the talk.
#
# A.0.1  the switch was never set, so SROS2 is silently off
# A.0.2  no strategy was set, so Permissive is what runs, and it fails open
# A.0.5  no plugin properties in the participant QoS or the XML profile
# A.0.6  nobody chose a domain, so the graph sits on the discoverable default
#
# The keystore still exists on disk: provisioning is unconditional in the
# entrypoint. Nothing reads it. That is the point the tree makes about A.0.1,
# and it is why an audit of the artefacts alone still passes on files nothing uses.
TARGET_SECURITY_ENABLE=false
TARGET_SECURITY_STRATEGY=Permissive
TARGET_OMIT_PLUGINS=true
# Domain 0 is the honest "never configured" value and it decides A.0.6.
TARGET_DOMAIN_ID=0
