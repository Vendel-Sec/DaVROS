# A.3.2 and A.3.3 made reachable from the network. dds.unauthenticated-join on its
# own admits unauthenticated participants, but they may only match topics that
# nothing protects, and with RTPS protection on they match nothing at all. This
# preset leaves the topics unprotected and RTPS in the clear, so a T1 attacker
# with no credentials sees and drives the whole graph. It also trips A.2.2,
# A.2.5, A.2.6 and A.3.4 to A.3.7: use it to demonstrate, not to isolate a leaf.
TARGET_ALLOW_UNAUTHENTICATED=true
TARGET_JOIN_AC=false
TARGET_RTPS_PROTECTION=NONE
TARGET_READ_AC=false
TARGET_WRITE_AC=false
TARGET_TOPIC_DISCOVERY_PROTECTION=false
TARGET_TOPIC_LIVELINESS_PROTECTION=false
TARGET_METADATA_PROTECTION=NONE
TARGET_DATA_PROTECTION=NONE
