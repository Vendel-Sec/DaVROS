# A.1.3, A.1.9, A.3.15 and A.4.3. One identity flashed into every robot, a
# certificate that never expires, one CA for identity and permissions, and that
# CA's signing key left on the robot. Compromise of one unit is the estate.
TARGET_SHARED_IDENTITY=true
TARGET_CERT_DAYS=36500
TARGET_SEPARATE_CA=false
TARGET_STRIP_CA_KEY=false
TARGET_KEY_MODE=0644
