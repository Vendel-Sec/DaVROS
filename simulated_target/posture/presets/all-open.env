# Every knob at its vulnerable value. Expect nearly every branch A leaf to be present.
# Useful as a smoke test: a check that finds nothing here is a check that does not work.
TARGET_SECURITY_ENABLE=false
TARGET_SECURITY_STRATEGY=Permissive
TARGET_DOMAIN_ID=0
TARGET_ENCLAVE_OVERRIDE=/robot
TARGET_KEYSTORE_MODE=0777
TARGET_OMIT_PLUGINS=true
TARGET_SHARED_IDENTITY=true
TARGET_KEY_MODE=0644
TARGET_KEY_PASSPHRASE=
TARGET_LEAK_PASSPHRASE=false
TARGET_CRL=false
TARGET_KEY_AGREEMENT=DH+MODP-2048-256
TARGET_LEGACY_ALGORITHMS=true
TARGET_CERT_DAYS=36500
TARGET_KEY_TYPE=rsa
TARGET_KEY_BITS=1024
TARGET_RTPS_PROTECTION=NONE
TARGET_DISCOVERY_PROTECTION=NONE
TARGET_LIVELINESS_PROTECTION=NONE
TARGET_METADATA_PROTECTION=NONE
TARGET_DATA_PROTECTION=NONE
TARGET_ORIGIN_AUTH=false
TARGET_ALLOW_UNAUTHENTICATED=true
TARGET_JOIN_AC=false
TARGET_READ_AC=false
TARGET_WRITE_AC=false
TARGET_TOPIC_DISCOVERY_PROTECTION=false
TARGET_TOPIC_LIVELINESS_PROTECTION=false
TARGET_WILDCARD_FIRST=true
TARGET_DOMAINS_RANGE=0-230
TARGET_PERMS_DEFAULT=ALLOW
TARGET_PERMS_DAYS=36500
TARGET_SUBJECT_WILDCARD=true
TARGET_SHARED_ENCLAVE=true
TARGET_RELAY_GRANT=true
TARGET_SEPARATE_CA=false
TARGET_SIGN_GOVERNANCE=false
TARGET_SIGN_PERMISSIONS=false
TARGET_STRIP_CA_KEY=false
TARGET_PROFILE_WRITABLE=true
TARGET_ROSBRIDGE=true
