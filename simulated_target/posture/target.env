# Simulated target posture. Each variable decides the leaves of
# ros2_attack_tree.md named in its comment: branch A, plus B.0.2's rosbridge.
#
# This file is the hardened baseline for the DDS-Security layer (branch A).
# A.1.5 is present by design.
#   docker compose up -d --force-recreate target peer

TARGET_REPROVISION=true

# --- A.0, is the security layer in force -------------------------------------
# A.0.1  anything but "true" is silently off
TARGET_SECURITY_ENABLE=true
# A.0.2  absent or other means Permissive
TARGET_SECURITY_STRATEGY=Enforce
# A.0.6  0 is the discoverable default
TARGET_DOMAIN_ID=42
# A.0.4  a value here collapses least privilege
TARGET_ENCLAVE_OVERRIDE=
# A.0.3, A.4.2
TARGET_KEYSTORE_MODE=0750
# A.0.5, A.1.1, A.2.1, A.3.1
TARGET_OMIT_PLUGINS=false
# A.1.1  Zenoh only. false keeps TLS but stops asking peers for a certificate
TARGET_ZENOH_MTLS=true

# --- A.1, authentication -----------------------------------------------------
# A.1.3  one cert DN for the whole fleet
TARGET_SHARED_IDENTITY=false
# A.1.4  keys are root:ros, so the nodes read them through the group bit
TARGET_KEY_MODE=0440
# A.1.5  empty means no encryption at rest, which is what the documented
# setup produces: sros2 writes enclave keys with NoEncryption(), and the
# enclave mechanism has no way to hand rmw a passphrase. A value here
# makes every node fail to create a participant, so the leaf is present
# in the baseline and its remediation is a TPM or PKCS#11 token.
TARGET_KEY_PASSPHRASE=
# A.1.5  store it beside the key it protects
TARGET_LEAK_PASSPHRASE=false
# A.1.6  no CRL means no revocation path
TARGET_CRL=true
# A.1.7  DH or DH+MODP-2048-256 is the weakness
TARGET_KEY_AGREEMENT=AUTO
# A.1.8
TARGET_LEGACY_ALGORITHMS=false
# A.1.9  36500 is effectively unbounded
TARGET_CERT_DAYS=365
# A.1.10 ec is P-256, rsa uses KEY_BITS
TARGET_KEY_TYPE=ec
# A.1.10 1024 is below the minimum
TARGET_KEY_BITS=2048

# --- A.2, confidentiality and integrity on the wire --------------------------
# A.2.2  NONE splices whole datagrams
TARGET_RTPS_PROTECTION=ENCRYPT
# A.2.3  NONE leaks the whole graph
TARGET_DISCOVERY_PROTECTION=ENCRYPT
# A.2.4
TARGET_LIVELINESS_PROTECTION=ENCRYPT
# A.2.5  NONE enables replay and injection
TARGET_METADATA_PROTECTION=ENCRYPT
# A.2.6  NONE, or A.2.7 if set to SIGN
TARGET_DATA_PROTECTION=ENCRYPT
# A.2.8  false means a shared group key
TARGET_ORIGIN_AUTH=true

# --- A.3, authorization ------------------------------------------------------
# A.3.2  the most damaging single switch
TARGET_ALLOW_UNAUTHENTICATED=false
# A.3.3
TARGET_JOIN_AC=true
# A.3.4
TARGET_READ_AC=true
# A.3.5  false on /cmd_vel is a safety event
TARGET_WRITE_AC=true
# A.3.6
TARGET_TOPIC_DISCOVERY_PROTECTION=true
# A.3.7
TARGET_TOPIC_LIVELINESS_PROTECTION=true
# A.3.8 and A.3.10  a "*" rule first shadows all others, in governance and permissions
TARGET_WILDCARD_FIRST=false
# A.3.9  e.g. 0-230 is far too broad
TARGET_DOMAINS_RANGE=
# A.3.11 ALLOW fails open
TARGET_PERMS_DEFAULT=DENY
# A.3.12
TARGET_PERMS_DAYS=365
# A.3.13
TARGET_SUBJECT_WILDCARD=false
# A.3.13 one enclave for every node
TARGET_SHARED_ENCLAVE=false
# A.3.14
TARGET_RELAY_GRANT=false
# A.3.15 sros2 shares one CA by default
TARGET_SEPARATE_CA=true
# A.3.16
TARGET_SIGN_GOVERNANCE=true
# A.3.17
TARGET_SIGN_PERMISSIONS=true

# --- A.4, delivery of the security artefacts ---------------------------------
# A.4.3  sros2 leaves private/ in place
TARGET_STRIP_CA_KEY=true
# A.4.1
TARGET_PROFILE_WRITABLE=false

# --- B, host and exposed services --------------------------------------------
# B.0.2  rosbridge_server on 0.0.0.0:9090, beside the graph, clients unauthenticated
TARGET_ROSBRIDGE=false
# B.0.2  the enclave it borrows, which puts it inside the trust boundary
TARGET_ROSBRIDGE_ENCLAVE=/mission_planner

# --- plumbing ----------------------------------------------------------------
# Set this to the target's IP if Fast DDS multicast discovery does not cross your
# docker bridge. Unicast initial peers are a workaround, not a security control.
TARGET_INITIAL_PEER=
